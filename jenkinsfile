pipeline {
    agent any

    stages {
        stage("checkout") {
            steps {
                checkout scm
            }
        }
        stage("build") {
            steps {
                sh "npm install"
            }
        }
        stage("test") {
            steps {
                sh "npm test"
            }
        }
        stage("Build Docker Image") {
           steps {
                script {
                    if (env.BRANCH_NAME == "main") {
                        sh "docker build -t nodemain:v1.0 ."
                    }
                    else {
                        sh "docker build -t nodedev:v1.0 ."
                    }
                }
           }
        }
        // stage("deploy") {
        //     steps {

        //     }
        // }
    }
}